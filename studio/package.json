{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "typegen": "sanity schemas extract --enforce-required-fields --force && sanity typegen generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.2",
    "@sanity/orderable-document-list": "^2.0.24",
    "@sanity/vision": "^6.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.15.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
