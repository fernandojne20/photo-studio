---
import ServiceCardItem from './ServiceCardItem.astro';
import ServicesCarousel from './ServicesCarousel.astro';
import { site } from '../../config/site';
import { shouldUseCarousel } from '../../lib/service-carousel';
import type { ServiceCard } from '../../content/types';

interface Props {
  services: ServiceCard[];
}

const { services } = Astro.props;
const { copy } = site;
const useCarousel = shouldUseCarousel(services.length);
---

{services.length > 0 && (
  <section id="servicios" class="services container">
    <h2 class="visually-hidden">{copy.servicesHeading}</h2>
    {useCarousel ? (
      <ServicesCarousel services={services} />
    ) : (
      <ul role="list" class="services__grid">
        {services.map((service) => (
          <li>
            <ServiceCardItem service={service} />
          </li>
        ))}
      </ul>
    )}
  </section>
)}

<style>
  .services {
    padding-block: var(--space-2xl);
    /* This is the single hairline between the card row and Contact; Contact does not draw its own top rule, to avoid doubling the line. */
    border-bottom: 1px solid var(--color-hairline);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
