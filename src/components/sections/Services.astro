---
import SanityImage from '../SanityImage.astro';
import { site } from '../../config/site';
import type { ServiceCard } from '../../content/types';

interface Props {
  services: ServiceCard[];
}

const { services } = Astro.props;
const { copy } = site;
---

{services.length > 0 && (
  <section id="servicios" class="services container">
    <h2 class="visually-hidden">{copy.servicesHeading}</h2>
    <ul role="list" class="services__grid">
      {services.map((service) => (
        <li class="services__card">
          <SanityImage
            image={service.image}
            widths={[300, 600, 900]}
            sizes="(max-width: 900px) 100vw, 25vw"
            aspectRatio="1 / 1"
            loading="lazy"
            class="services__image"
          />
          <span class="services__label">{service.title}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .services {
    padding-block: var(--space-2xl);
    /* This is the single hairline between the card row and Contact; Contact does not draw its own top rule, to avoid doubling the line. */
    border-bottom: 1px solid var(--color-hairline);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .services__card {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .services :global(.services__image) {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .services__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-hero);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .services__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .services__card {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .services__label {
      position: static;
      margin-top: var(--space-sm);
      color: var(--color-text);
    }
  }
</style>
