---
import SanityImage from '../SanityImage.astro';
import Monogram from '../Monogram.astro';
import PortableTextBody from '../PortableTextBody.astro';
import { site, buildWhatsAppUrl } from '../../config/site';
import { buildSanitySrcSet, hotspotObjectPosition } from '../../lib/sanity-image';
import type { BiographyContent, BiographyCta } from '../../content/types';
import { analyticsEventForHref } from '../../lib/analytics-events';

interface Props {
  biography: BiographyContent;
}

const { biography } = Astro.props;

function resolveCtaHref(cta: BiographyCta): string {
  switch (cta.target) {
    case 'whatsapp':
      return buildWhatsAppUrl(site.whatsapp);
    case 'contact':
      return '#contacto';
    case 'url':
      return cta.url ?? '#';
  }
}

const cta = biography.cta;
const ctaHref = cta ? resolveCtaHref(cta) : undefined;
const ctaIsExternal = cta ? cta.target === 'whatsapp' || cta.target === 'url' : false;
// By destination, not by target: an editor can paste a WhatsApp or Instagram
// URL as a plain `url` call to action, and that is a conversion too.
const ctaEvent = ctaHref ? analyticsEventForHref(ctaHref, site.instagram.url) : undefined;
const ctaAnalytics = ctaEvent
  ? { 'data-analytics-event': ctaEvent, 'data-analytics-placement': 'biography' }
  : {};

/* The mobile card has a fixed 3:2 frame, so the Sanity CDN can crop around
   the editor's hotspot at exactly that ratio. A placeholder portrait has no
   Sanity asset to derive that crop from, so the source only exists for a
   real editor photo. */
const MOBILE_RATIO = '3 / 2';
const mobileSrcSet = biography.portrait.source
  ? buildSanitySrcSet(biography.portrait, [400, 640, 900], MOBILE_RATIO)
  : null;

/* The desktop frame is the whole section, whose height follows the text, so
   no fixed CDN ratio would match it. The full image is delivered instead and
   the browser crops it, positioned so the hotspot always stays in frame. */
const portraitPosition = hotspotObjectPosition(biography.portrait);
---

<section id="biografia" class="biography">
  <div class="biography__inner">
    <Monogram tone="muted" class="biography__monogram" />
    <p class="biography__script" aria-hidden="true">
      {site.tagline}
    </p>
    <h2 class="biography__name">{site.name}</h2>
    <PortableTextBody value={biography.body} class="biography__body" />
    {cta && (
      <a
        class="biography__cta"
        href={ctaHref}
        target={ctaIsExternal ? '_blank' : undefined}
        rel={ctaIsExternal ? 'noopener' : undefined}
        {...ctaAnalytics}
      >
        {cta.label}
      </a>
    )}
    <div
      class="biography__portrait"
      style={portraitPosition ? `--biography-portrait-position: ${portraitPosition}` : undefined}
    >
      <picture>
        {mobileSrcSet && (
          <source
            media="(max-width: 900px)"
            srcset={mobileSrcSet.srcset ?? mobileSrcSet.src}
            sizes="calc(100vw - 80px)"
          />
        )}
        <SanityImage
          image={biography.portrait}
          widths={[640, 960, 1366, 1600, 1920]}
          sizes="100vw"
          loading="lazy"
          class="biography__portrait-image"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  /* The custom properties say where the text column starts and how wide it
     is. 30rem is the mockup's paragraph width, ending at about 45% of a
     1366px viewport, over the dark side the portrait itself must have (the
     Studio field says so): no overlay darkens the photo. */
  .biography {
    --biography-text-start: max(
      var(--container-padding),
      calc((100% - var(--container-width)) / 2)
    );
    --biography-column: 30rem;
    /* Containing block for the full-bleed portrait; isolated so its negative z-index stays local to this section, not the whole page. */
    position: relative;
    isolation: isolate;
    background: var(--color-bg-dark);
    color: var(--color-text-dark);
  }

  .biography__inner {
    display: grid;
    align-items: center;
    padding-block: var(--space-2xl);
    /* Left edge aligns with the shared container; the right edge is left unpadded so the portrait (now a full-section background) can bleed to the true viewport edge. */
    padding-inline-start: var(--biography-text-start);
    /* One text track; the rest of the row is empty grid space over the photo. */
    grid-template-columns: minmax(0, min(50%, var(--biography-column)));
    grid-template-areas:
      'monogram'
      'tagline'
      'name'
      'body'
      'cta'
      'portrait';
  }

  :global(.biography__monogram) {
    grid-area: monogram;
    margin-bottom: var(--space-sm);
  }

  .biography__script {
    grid-area: tagline;
    font-family: var(--font-script);
    /* One line at every width, as in the mockup: the phrase is about 20.6em wide in this script face, so on narrow phones the size follows the viewport (minus the container's 16px sides) instead of wrapping. */
    font-size: min(var(--text-md), calc(4.8vw - 2px));
    color: var(--color-heading-dark);
    margin-bottom: var(--space-sm);
  }

  .biography__name {
    grid-area: name;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    /* Wide enough that the name spans about the paragraph's width, as in the mockup. Letter-spacing also opens a gap AFTER the last character; the negative margin cancels it so the name still centers correctly once mobile centers the whole column. */
    letter-spacing: 0.95em;
    margin-inline-end: -0.95em;
    text-transform: uppercase;
    color: var(--color-heading-dark);
    margin-bottom: var(--space-lg);
  }

  .biography :global(.biography__body) {
    grid-area: body;
  }

  .biography__cta {
    grid-area: cta;
    justify-self: center;
    margin-top: var(--space-md);
    /* Tight, proportional padding: em scales with the fluid font-size below. */
    padding: 0.12em 0.95em;
    /* Faint fill and a dim border, matching the mockup's translucent pill: rgb(255 255 255 / 25%) over this near-black background blends to roughly #474747, close to the mockup's ~#4a4a4a. */
    background: rgb(255 255 255 / 4%);
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    /* Fluid from 22px at 393px to 37.6px at 1366px (the mockup's sizes). The larger desktop size also matters for Minion's optical-size axis: `font-optical-sizing: auto` (the browser default, left untouched) picks the display design here instead of the small-text one. */
    font-size: clamp(1.375rem, 0.981rem + 1.603vw, 2.35rem);
    line-height: 1.2;
    color: var(--color-heading-dark);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      outline-color var(--duration-fast) var(--ease-standard);
  }

  .biography__cta:hover {
    opacity: 0.8;
  }

  /* The default focus ring is too dark to read against this section's
     near-black background, so it is swapped for a light token here. */
  .biography__cta:focus-visible {
    outline-color: var(--color-heading-dark);
  }

  .biography__portrait {
    grid-area: portrait;
    /* Full-section background, behind the text. `.biography__inner` stays unpositioned so this escapes its padding and fills the section edge to edge. */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  /* `<picture>` has no box of its own here, so percentage sizing on the
     `<img>` below resolves directly against `.biography__portrait`. */
  .biography__portrait picture {
    display: contents;
  }

  /* The position comes from the editor's hotspot (set inline on the wrapper);
     it also applies to a mobile card served without its own 3:2 source. */
  .biography :global(.biography__portrait-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--biography-portrait-position, 50% 50%);
  }

  @media (max-width: 900px) {
    .biography__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding-inline: var(--container-padding);
      grid-template-areas:
        'monogram'
        'tagline'
        'portrait'
        'name'
        'body'
        'cta';
    }

    .biography__name {
      /* The desktop tracking overflows a phone; keep the original, narrower tracking, with its own matching trailing-gap compensation. */
      letter-spacing: var(--tracking-heading);
      margin-inline-end: calc(-1 * var(--tracking-heading));
    }

    .biography__portrait {
      grid-area: portrait;
      position: static;
      width: auto;
      height: auto;
      z-index: auto;
      /* Container padding (16px) plus this token (24px) ≈ the mockup's 40px inset from each viewport edge. */
      margin-inline: var(--space-md);
      margin-block: var(--space-md);
      border-radius: var(--radius-card);
      overflow: hidden;
    }

    .biography :global(.biography__portrait-image) {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }
  }
</style>
