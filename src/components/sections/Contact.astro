---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { buildWhatsAppUrl, site } from '../../config/site';

const { copy } = site;
const whatsAppUrl = buildWhatsAppUrl(site.whatsapp);
// Turnstile's widget language: the two-letter code from the site locale
// (`es-AR` -> `es`), passed to the client script through a `data-*`
// attribute so it never has to import `site.ts` (see the language contract
// in `odd/tasks/contact-conversion.md`).
const turnstileLanguage = site.locale.split('-')[0];

// Every visitor-facing string the client script needs, keyed the same way
// the domain error codes and the JSON response are: read once here from
// `site.ts`, handed to the browser as one `data-messages` attribute.
// `src/scripts/contact-form.ts` never imports `site.ts` directly.
const contactMessages = {
  errors: copy.contactForm.errors,
  sending: copy.contactForm.sending,
  success: copy.contactForm.success,
  captchaFailed: copy.contactForm.captchaFailed,
  notConfigured: copy.contactForm.notConfigured,
  deliveryFailed: copy.contactForm.deliveryFailed,
  network: copy.contactForm.network,
  interactiveChallenge: copy.contactForm.interactiveChallenge,
};
---

<section id="contacto" class="contact container">
  <div class="contact__inner">
    <div class="contact__info">
      <h2 class="contact__heading">{copy.contact.heading}</h2>
      <p class="contact__intro">{copy.contact.intro}</p>
      <p class="contact__paragraph">{copy.contact.paragraph}</p>
      <p class="contact__alt">
        {copy.contact.alternativeIntro}
        <br />
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </p>
      <p class="contact__alt">
        {copy.contact.alternativeCall}
        <br />
        <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phoneDisplay}</a>
      </p>
    </div>

    <form
      class="contact__form"
      method="post"
      novalidate
      data-contact-form
      data-messages={JSON.stringify(contactMessages)}
    >
      <!-- Honeypot: invisible to sighted and assistive-technology visitors
           (off-screen, `aria-hidden` AND `inert`, unreachable by keyboard),
           but a real text input a scripted bot is likely to fill blindly.
           Filling it never short-circuits the client: the submission still
           goes to the server exactly like a normal one, and
           `validateContactSubmission` there is what silently drops it (see
           `src/scripts/contact-form.ts` and the task document for why:
           identical client behavior either way means a bot learns nothing
           from the network traffic).

           Named/labelled `topic_ref` / "Referencia interna" — deliberately
           NOT anything like "website", "url", "company", "name", "email",
           "phone", or "address": a bait field that matches a real
           autofill/password-manager profile field is a documented
           false-positive source (password managers and browser autofill
           have been observed filling exactly a field named "website" in a
           published honeypot library). `data-1p-ignore`, `data-lpignore`,
           `data-bwignore`, `data-form-type="other"` and
           `data-protonpass-ignore` are the corresponding vendor opt-outs
           for 1Password, LastPass, Bitwarden and Proton Pass. The JSON key
           this becomes on submit is still `website` (the server contract
           in `src/contact/validate.ts` does not change) — only the DOM
           name/label changed; do not rename it back to match. -->
      <div class="contact__honeypot" aria-hidden="true" inert>
        <label for="contact-topic-ref">{copy.contactForm.honeypotLabel}</label>
        <input
          id="contact-topic-ref"
          name="topic_ref"
          type="text"
          tabindex="-1"
          autocomplete="off"
          data-1p-ignore
          data-lpignore="true"
          data-bwignore
          data-form-type="other"
          data-protonpass-ignore="true"
        />
      </div>

      <div class="contact__row">
        <div class="contact__field">
          <label for="contact-first-name">{copy.contactForm.firstName}</label>
          <input
            id="contact-first-name"
            name="firstName"
            type="text"
            autocomplete="given-name"
            maxlength="80"
          />
          <span id="contact-first-name-error" class="contact__error"></span>
        </div>
        <div class="contact__field">
          <label for="contact-last-name">{copy.contactForm.lastName}</label>
          <input
            id="contact-last-name"
            name="lastName"
            type="text"
            autocomplete="family-name"
            maxlength="80"
          />
          <span id="contact-last-name-error" class="contact__error"></span>
        </div>
      </div>

      <div class="contact__row">
        <div class="contact__field">
          <label for="contact-email">
            {copy.contactForm.email}
            <span aria-hidden="true">*</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            required
          />
          <span id="contact-email-error" class="contact__error"></span>
        </div>
        <div class="contact__field">
          <label for="contact-phone">{copy.contactForm.phone}</label>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="30"
          />
          <span id="contact-phone-error" class="contact__error"></span>
        </div>
      </div>

      <div class="contact__field contact__field--full">
        <label for="contact-message">{copy.contactForm.message}</label>
        <textarea id="contact-message" name="message" rows="4" maxlength="2000"></textarea>
        <span id="contact-message-error" class="contact__error"></span>
      </div>

      <p class="contact__required-note">{copy.contactForm.requiredNote}</p>

      <!-- `tabindex="-1"`: not part of the normal tab order, but a target
           `contact-form.ts` can focus when an interactive challenge needs
           the visitor's attention (`before-interactive-callback`), so a
           keyboard visitor lands next to it instead of staying stranded on
           the (still `aria-disabled`) submit button. -->
      <div
        class="contact__turnstile"
        data-turnstile
        data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
        data-language={turnstileLanguage}
        tabindex="-1"
      ></div>

      <!-- Safe without JavaScript: no `action` (so no navigation to the
           JSON endpoint) and disabled server-side, so it can never be
           submitted at all until `contact-form.ts` enables it. -->
      <button type="submit" class="contact__submit" disabled data-contact-submit>
        {copy.contactForm.submit}
      </button>

      <!-- Both regions are always rendered (never `display: none`) so they
           stay in the accessibility tree at all times; hidden-but-present
           is what makes an `aria-live` region reliably announced the
           moment text is written into it. Neither ever receives focus:
           see `contact-form.ts` for why. -->
      <p
        id="contact-status"
        class="contact__status"
        role="status"
        aria-live="polite"
        data-contact-status
      ></p>
      <p
        id="contact-status-error"
        class="contact__status contact__status--error"
        role="alert"
        aria-live="assertive"
        data-contact-status-error
      ></p>

      <noscript>
        <p class="contact__noscript">
          {copy.contactForm.noscript.message}{' '}
          <a href={whatsAppUrl} target="_blank" rel="noopener">
            {copy.contactForm.noscript.whatsappCta}
          </a>{' '}
          {copy.contactForm.noscript.emailCta}{' '}
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
        </p>
      </noscript>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-2xl);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-xl);
  }

  .contact__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .contact__intro {
    margin-bottom: var(--space-md);
  }

  .contact__paragraph {
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
  }

  .contact__alt {
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
  }

  .contact__alt a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Off-screen, not `display: none`: a bot inspecting computed styles or
     just filling every input in DOM order still finds and can fill this
     field, which is the point of a honeypot. `aria-hidden` on the wrapper
     removes it from the accessibility tree for real assistive-technology
     visitors; `tabindex="-1"` on the input keeps it out of the tab order. */
  .contact__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    left: -9999px;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .contact__field label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-ui);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .contact__field input,
  .contact__field textarea {
    border: none;
    border-bottom: 1px solid var(--color-hairline);
    background: transparent;
    padding-block: var(--space-2xs);
    font-family: var(--font-body);
    color: var(--color-text);
    resize: none;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .contact__field input:hover,
  .contact__field textarea:hover {
    border-color: var(--color-text);
  }

  .contact__field input[aria-invalid='true'],
  .contact__field textarea[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  /* Quiet by design: small text under the field, no icon, no background. */
  .contact__error {
    font-size: var(--text-xs);
    color: var(--color-error);
  }

  .contact__error:empty {
    display: none;
  }

  .contact__required-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contact__turnstile {
    width: 100%;
    max-width: 300px;
  }

  .contact__submit {
    align-self: flex-end;
    padding: var(--space-xs) var(--space-lg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .contact__submit:hover {
    opacity: 0.7;
  }

  .contact__submit:disabled,
  .contact__submit[aria-disabled='true'] {
    opacity: 0.5;
    cursor: default;
  }

  .contact__status {
    font-size: var(--text-sm);
  }

  /* A hidden `aria-live` region is not reliably announced once text is
     written into it: browsers/AT need the region already present in the
     accessibility tree beforehand. `display: none` (and `visibility:
     hidden`) both remove it from that tree, so while empty this uses the
     same off-screen 1px-clip technique as `.visually-hidden` in
     `global.css` instead — present, but taking no visual space and no flex
     gap (an absolutely positioned element is not a flex item). Once it has
     text, the rule below no longer matches and it becomes a normal static
     block again. */
  .contact__status:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact__status--error {
    color: var(--color-error);
  }

  .contact__noscript {
    color: var(--color-text-muted);
  }

  .contact__noscript a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 900px) {
    .contact__inner {
      grid-template-columns: 1fr;
    }

    .contact__alt {
      display: none;
    }
  }
</style>
