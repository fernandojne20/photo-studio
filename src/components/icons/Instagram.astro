---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  width="1em"
  height="1em"
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect x="5" y="5" width="22" height="22" rx="6" stroke="currentColor" stroke-width="1.5"
  ></rect>
  <circle cx="16" cy="16" r="5.5" stroke="currentColor" stroke-width="1.5"></circle>
  <circle cx="22.5" cy="9.5" r="1.25" fill="currentColor"></circle>
</svg>
