---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Welcome from '../components/sections/Welcome.astro';
import PortfolioGrid from '../components/sections/PortfolioGrid.astro';
import Biography from '../components/sections/Biography.astro';
import Services from '../components/sections/Services.astro';
import Contact from '../components/sections/Contact.astro';
import Instagram from '../components/sections/Instagram.astro';
import { site } from '../config/site';
import { getHomeContent } from '../content/home';

const content = await getHomeContent();
---

<BaseLayout title={`${site.name} — Fotografía`}>
  <Header slot="header" />

  <Hero hero={content.hero} />
  <Welcome />
  <PortfolioGrid items={content.portfolio} />
  <Biography biography={content.biography} />
  <Services services={content.services} />
  <Contact />
  <Instagram />

  <Footer slot="footer" />
</BaseLayout>
