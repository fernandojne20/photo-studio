---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/icons/WhatsApp.astro';
import Instagram from '../components/icons/Instagram.astro';
import { site, buildWhatsAppUrl } from '../config/site';
import {
  heroPlaceholder,
  portfolioPlaceholders,
  biographyPortraitPlaceholder,
  servicePlaceholders,
} from '../data/placeholders';

const whatsAppUrl = buildWhatsAppUrl(site.whatsapp);
const { copy } = site;
const contactAlternativeLine = `${copy.contact.alternativeIntro} ${site.contact.email} ${copy.contact.alternativeCall} ${site.contact.phoneDisplay}`;
---

<BaseLayout title={`${site.name} — Fotografía`}>
  <Header />

  <main>
    <section id="inicio" class="hero">
      <picture>
        <source media="(max-width: 640px)" srcset={heroPlaceholder.mobile.src} />
        <img
          class="hero__image"
          src={heroPlaceholder.desktop.src}
          alt={heroPlaceholder.desktop.alt}
          width={heroPlaceholder.desktop.width}
          height={heroPlaceholder.desktop.height}
          loading="eager"
          decoding="async"
        />
      </picture>
      <a class="hero__cta" href={whatsAppUrl} target="_blank" rel="noopener">
        <WhatsApp class="hero__cta-icon" />
        <span>{copy.heroCtaLabel}</span>
      </a>
    </section>

    <section id="bienvenidos" class="welcome container">
      <h2 class="welcome__heading">{copy.welcomeHeading}</h2>
      <p class="welcome__paragraph">{copy.welcomeParagraphs[0]}</p>
      <p class="welcome__paragraph">{copy.welcomeParagraphs[1]}</p>
    </section>

    <section id="momentos" class="portfolio container">
      <h2 class="visually-hidden">{copy.portfolioHeading}</h2>
      <span class="portfolio__pill" aria-hidden="true">{copy.portfolioHeading}</span>
      <ul role="list" class="portfolio__grid">
        {
          portfolioPlaceholders.map((image) => (
            <li class="portfolio__item">
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="biografia" class="biography">
      <div class="container biography__inner">
        <div class="biography__content">
          <p class="biography__script" aria-hidden="true">{site.tagline}</p>
          <h2 class="biography__name">{copy.biographyFallback.name}</h2>
          {
            copy.biographyFallback.paragraphs.map((paragraph) => (
              <p class="biography__paragraph">{paragraph}</p>
            ))
          }
          <a class="biography__cta" href={whatsAppUrl} target="_blank" rel="noopener">
            {copy.biographyCtaLabel}
          </a>
        </div>
        <div class="biography__portrait">
          <img
            src={biographyPortraitPlaceholder.src}
            alt={biographyPortraitPlaceholder.alt}
            width={biographyPortraitPlaceholder.width}
            height={biographyPortraitPlaceholder.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section id="servicios" class="services container">
      <h2 class="visually-hidden">{copy.servicesHeading}</h2>
      <ul role="list" class="services__grid">
        {
          servicePlaceholders.map((service) => (
            <li class="services__card">
              <img
                src={service.src}
                alt={service.alt}
                width={service.width}
                height={service.height}
                loading="lazy"
                decoding="async"
              />
              <span class="services__label">{service.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="contacto" class="contact container">
      <h2 class="contact__heading">{copy.contact.heading}</h2>
      <p class="contact__intro">{copy.contact.intro}</p>
      <p class="contact__paragraph">{copy.contact.paragraph}</p>
      <p class="contact__paragraph">{contactAlternativeLine}</p>
      <p class="contact__form-placeholder"></p>
    </section>

    <section id="instagram" class="instagram container">
      <h2 class="instagram__heading">{copy.instagramHeading}</h2>
      <a
        class="instagram__link"
        href={site.instagram.url}
        target="_blank"
        rel="noopener"
        aria-label={copy.a11y.instagram}
      >
        <Instagram class="instagram__icon" />
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
  }

  .hero__image {
    width: 100%;
    height: 100vh;
    object-fit: cover;
  }

  .hero__cta {
    position: absolute;
    left: 50%;
    bottom: var(--space-2xl);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 85%);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
  }

  .welcome {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .welcome__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-lg);
  }

  .welcome__paragraph {
    max-width: 62ch;
    margin-inline: auto;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .portfolio {
    padding-block: var(--space-2xl);
    text-align: center;
  }

  .portfolio__pill {
    display: inline-block;
    margin-bottom: var(--space-lg);
    padding: var(--space-xs) var(--space-lg);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    font-size: var(--text-md);
  }

  .portfolio__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .portfolio__item img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .biography {
    background: var(--color-bg-dark);
    color: var(--color-text-dark);
    padding-block: var(--space-2xl);
  }

  .biography__inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .biography__script {
    font-family: var(--font-script);
    font-size: var(--text-lg);
    color: var(--color-heading-dark);
    margin-bottom: var(--space-sm);
  }

  .biography__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    color: var(--color-heading-dark);
    margin-bottom: var(--space-lg);
  }

  .biography__paragraph {
    margin-bottom: var(--space-md);
  }

  .biography__cta {
    display: inline-block;
    margin-top: var(--space-md);
    padding: var(--space-xs) var(--space-lg);
    border: 1px solid var(--color-text-dark);
    border-radius: var(--radius-pill);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-heading-dark);
  }

  .biography__portrait img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .services {
    padding-block: var(--space-2xl);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .services__card {
    position: relative;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .services__card img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .services__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-hero);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    background: var(--color-overlay-dark);
  }

  .contact {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-hairline);
  }

  .contact__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    margin-bottom: var(--space-sm);
  }

  .contact__intro {
    margin-bottom: var(--space-md);
  }

  .contact__paragraph {
    max-width: 40ch;
    margin-bottom: var(--space-sm);
    color: var(--color-text-muted);
  }

  .instagram {
    padding-block: var(--space-2xl);
    text-align: center;
    border-top: 1px solid var(--color-hairline);
  }

  .instagram__heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  /* Icons are sized with `1em`, so the link's font-size controls them. */
  .instagram__link {
    display: inline-flex;
    font-size: 1.75rem;
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .biography__inner {
      grid-template-columns: 1fr;
    }

    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
