---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../config/site';
import Seo from '../components/Seo.astro';
import type { CmsImage } from '../content/types';

interface Props {
  title: string;
  description?: string;
  /** Forwarded to `Seo.astro` to derive the Open Graph/Twitter sharing image. */
  heroImage?: CmsImage;
  /** Forwarded to `Seo.astro` — forces `noindex, nofollow`, no canonical/`og:url`. */
  forceNonIndexable?: boolean;
}

const { title, description = site.description, heroImage, forceNonIndexable } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Matches --color-bg in src/styles/tokens.css (#ffffff): duplicated
    here because a meta tag's value must be a static string, not a CSS
    custom property. This project has no separate brand/accent color token,
    so the page's own background is the most honest choice for the browser
    UI tint. */}
    <meta name="theme-color" content="#ffffff" />
    <Seo
      title={title}
      description={description}
      heroImage={heroImage}
      forceNonIndexable={forceNonIndexable}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {/* cssVariable values are the ones registered in astro.config.mjs (font families), not the role aliases from tokens.css. */}
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-futura-light" preload />
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-minion" preload />
    <Font cssVariable="--font-adelia" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {site.copy.a11y.skipToContent}
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // Analytics-ready dispatcher (PD-05): a same-origin module, loaded
      // once per page so the `studio:analytics` listener is installed
      // before any conversion link can be activated. See "Analytics hooks"
      // in README.md; no vendor is installed and nothing subscribes today.
      import '../scripts/analytics';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    z-index: 100;
    padding: var(--space-xs) var(--space-md);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-ui);
    transition: top var(--duration-fast) var(--ease-standard);
  }

  .skip-link:focus {
    top: 0;
  }
</style>
